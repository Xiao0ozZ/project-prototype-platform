{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-prototype-platform.local/schemas/prd-bindings.schema.json",
  "title": "Prototype component to PRD bindings",
  "type": "object",
  "required": ["schemaVersion", "projectId", "bindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pagePath", "target", "prd"],
        "properties": {
          "id": { "type": "string" },
          "pagePath": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "required": ["domPath", "tag"],
            "properties": {
              "domPath": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "tag": { "type": "string", "minLength": 1 },
              "classes": { "type": "array", "items": { "type": "string" } },
              "text": { "type": "string" }
            },
            "additionalProperties": true
          },
          "prd": {
            "type": "object",
            "required": ["document", "anchor"],
            "properties": {
              "document": { "type": "string", "pattern": "\\.md$" },
              "anchor": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "summary": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
