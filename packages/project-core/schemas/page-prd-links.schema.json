{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-prototype-platform.local/schemas/page-prd-links.schema.json",
  "title": "Page to PRD links",
  "type": "object",
  "required": ["schemaVersion", "projectId", "links"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [{ "type": "string", "pattern": "\\.md$" }, { "type": "null" }]
        }
      }
    }
  },
  "additionalProperties": false
}
